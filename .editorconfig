root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{toml,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.vbs]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{wav,mp3,m4a,aac,ogg,png,jpg,jpeg,ico,lnk}]
insert_final_newline = unset
trim_trailing_whitespace = unset
