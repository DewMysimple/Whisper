{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperSubtitle",
  "version": "0.1.0",
  "identifier": "local.whispersubtitle.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperSubtitle",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
