{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../build/release/stage/_internal/worker/": "_internal/worker/",
      "../../../build/release/stage/_internal/distribution/": "_internal/distribution/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
