{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whisper-subtitle.local/contracts/desktop-ipc/v1/desktop_ipc.schema.json",
  "title": "WhisperSubtitle Desktop IPC v1",
  "oneOf": [
    { "$ref": "#/$defs/CommandMessage" },
    { "$ref": "#/$defs/EventMessage" },
    { "$ref": "#/$defs/ErrorMessage" }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "CommandMethod": {
      "type": "string",
      "enum": [
        "system.health",
        "system.environment",
        "system.metrics",
        "media.inspect",
        "model.load",
        "model.unload",
        "transcription.start",
        "transcription.cancel",
        "worker.shutdown"
      ]
    },
    "EventCode": {
      "type": "string",
      "enum": [
        "worker.ready",
        "command.completed",
        "model.loading",
        "model.ready",
        "task.queued",
        "task.progress",
        "task.completed",
        "task.failed",
        "task.cancelled"
      ]
    },
    "TaskStage": {
      "type": "string",
      "enum": [
        "input.validating",
        "input.discovering",
        "model.loading",
        "transcription.running",
        "postprocess.running",
        "output.writing",
        "task.finalizing"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "protocol.invalid_json",
        "protocol.invalid_message",
        "protocol.unsupported_version",
        "protocol.unknown_method",
        "request.invalid",
        "task.not_found",
        "task.conflict",
        "worker.busy",
        "worker.internal",
        "environment.unavailable",
        "model.load_failed",
        "transcription.failed",
        "output.failed"
      ]
    },
    "EmptyObject": {
      "type": "object",
      "maxProperties": 0
    },
    "InputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "origin"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "directory"] },
        "origin": { "enum": ["dialog", "drop", "paste", "manual"] }
      }
    },
    "ParameterOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": { "enum": ["transcribe", "translate"] },
        "beam_size": { "type": "integer", "minimum": 1, "maximum": 20 },
        "best_of": { "type": "integer", "minimum": 1, "maximum": 20 },
        "patience": { "type": "number", "minimum": 0, "maximum": 5 },
        "length_penalty": { "type": "number", "minimum": 0, "maximum": 2 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "repetition_penalty": { "type": "number", "minimum": 1, "maximum": 2 },
        "no_repeat_ngram_size": { "type": "integer", "minimum": 0, "maximum": 10 },
        "compression_ratio_threshold": { "type": "number", "minimum": 0, "maximum": 10 },
        "log_prob_threshold": { "type": "number", "minimum": -10, "maximum": 0 },
        "no_speech_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "condition_on_previous_text": { "type": "boolean" },
        "prompt_reset_on_temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "initial_prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "hotwords": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "min_silence_duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "TranscriptionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_preset_id", "overrides"],
      "properties": {
        "base_preset_id": { "enum": ["cn", "cn2", "en_v1", "en_v2"] },
        "overrides": { "$ref": "#/$defs/ParameterOverrides" }
      }
    },
    "OutputTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "directory": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "SubtitleParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_characters_per_line",
        "max_lines_per_cue",
        "min_cue_duration_ms",
        "max_cue_duration_ms",
        "max_characters_per_second",
        "cue_gap_ms"
      ],
      "properties": {
        "max_characters_per_line": { "type": "integer", "minimum": 8, "maximum": 84 },
        "max_lines_per_cue": { "type": "integer", "minimum": 1, "maximum": 3 },
        "min_cue_duration_ms": { "type": "integer", "minimum": 250, "maximum": 5000 },
        "max_cue_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 15000 },
        "max_characters_per_second": { "type": "number", "minimum": 5, "maximum": 40 },
        "cue_gap_ms": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "OutputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "txt", "markdown", "preserve_source_txt", "conflict_policy"],
      "properties": {
        "mode": { "enum": ["compatibility", "custom"] },
        "root_directory": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "txt": { "$ref": "#/$defs/OutputTarget" },
        "markdown": { "$ref": "#/$defs/OutputTarget" },
        "srt": { "$ref": "#/$defs/OutputTarget" },
        "subtitle": { "$ref": "#/$defs/SubtitleParameters" },
        "preserve_source_txt": { "type": "boolean" },
        "preserve_source_markdown": { "type": "boolean", "default": false },
        "conflict_policy": { "enum": ["overwrite", "fail", "auto_rename"] }
      },
      "allOf": [
        {
          "anyOf": [
            { "properties": { "txt": { "properties": { "enabled": { "const": true } } } } },
            { "properties": { "markdown": { "properties": { "enabled": { "const": true } } } } },
            {
              "required": ["srt"],
              "properties": { "srt": { "properties": { "enabled": { "const": true } } } }
            }
          ]
        },
        {
          "if": { "properties": { "mode": { "const": "custom" } } },
          "then": {
            "anyOf": [
              {
                "required": ["root_directory"],
                "properties": { "root_directory": { "type": "string", "minLength": 1 } }
              },
              {
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "properties": { "txt": { "properties": { "enabled": { "const": false } } } }
                      },
                      {
                        "properties": {
                          "txt": {
                            "required": ["directory"],
                            "properties": { "directory": { "type": "string", "minLength": 1 } }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "markdown": { "properties": { "enabled": { "const": false } } }
                        }
                      },
                      {
                        "properties": {
                          "markdown": {
                            "required": ["directory"],
                            "properties": { "directory": { "type": "string", "minLength": 1 } }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "properties": { "srt": { "properties": { "enabled": { "const": false } } } }
                      },
                      {
                        "properties": {
                          "srt": {
                            "required": ["directory"],
                            "properties": { "directory": { "type": "string", "minLength": 1 } }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": ["srt"],
            "properties": { "srt": { "properties": { "enabled": { "const": true } } } }
          },
          "then": { "required": ["subtitle"] }
        }
      ]
    },
    "HardwarePreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "gpu_device_index",
        "cuda_compute_type",
        "cpu_compute_type",
        "cpu_threads"
      ],
      "properties": {
        "mode": { "enum": ["auto", "cuda", "cpu"] },
        "gpu_device_index": { "type": "integer", "minimum": 0, "maximum": 31 },
        "cuda_compute_type": { "enum": ["float16", "int8_float16", "float32"] },
        "cpu_compute_type": { "enum": ["int8", "float32"] },
        "cpu_threads": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "ResolvedHardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "device_index", "compute_type", "cpu_threads"],
      "properties": {
        "device": { "enum": ["cuda", "cpu"] },
        "device_index": { "type": "integer", "minimum": 0 },
        "compute_type": { "type": "string", "minLength": 1 },
        "cpu_threads": { "type": "integer", "minimum": 0 }
      }
    },
    "TranscriptionStartParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "profile", "output"],
      "properties": {
        "model_id": { "enum": ["tiny", "base", "small", "medium", "large-v3", "large-v3-turbo"] },
        "recognition_strategy": {
          "enum": ["stable_primary", "mixed_zh_en", "zh_detail_review"]
        },
        "hardware": { "$ref": "#/$defs/HardwarePreference" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/InputSource" }
        },
        "profile": { "$ref": "#/$defs/TranscriptionProfile" },
        "output": { "$ref": "#/$defs/OutputPolicy" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "properties": {
                  "overrides": {
                    "required": ["task"],
                    "properties": { "task": { "const": "translate" } }
                  }
                }
              }
            }
          },
          "then": {
            "required": ["model_id"],
            "properties": {
              "model_id": {
                "enum": ["tiny", "base", "small", "medium", "large-v3"]
              },
              "profile": {
                "properties": {
                  "base_preset_id": { "enum": ["en_v1", "en_v2"] }
                }
              }
            }
          }
        }
      ]
    },
    "ModelLoadParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "hardware": { "$ref": "#/$defs/HardwarePreference" }
      }
    },
    "MediaInspectParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "TranscriptionCancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id"],
      "properties": {
        "task_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "CommandMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "request_id", "method", "params"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "type": { "const": "command" },
        "request_id": { "$ref": "#/$defs/Identifier" },
        "method": { "$ref": "#/$defs/CommandMethod" },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "system.health",
                  "system.environment",
                  "system.metrics",
                  "model.unload",
                  "worker.shutdown"
                ]
              }
            }
          },
          "then": { "properties": { "params": { "$ref": "#/$defs/EmptyObject" } } }
        },
        {
          "if": { "properties": { "method": { "const": "model.load" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/ModelLoadParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "media.inspect" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/MediaInspectParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "transcription.start" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/TranscriptionStartParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "transcription.cancel" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/TranscriptionCancelParams" } } }
        }
      ]
    },
    "WorkerReadyData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "capabilities"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methods", "events"],
          "properties": {
            "methods": {
              "type": "array",
              "items": { "$ref": "#/$defs/CommandMethod" },
              "uniqueItems": true
            },
            "events": {
              "type": "array",
              "items": { "$ref": "#/$defs/EventCode" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "CommandCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "result"],
      "properties": {
        "method": { "$ref": "#/$defs/CommandMethod" },
        "result": { "type": "object" }
      }
    },
    "ModelLoadingData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 }
      }
    },
    "ModelReadyData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "device", "compute_type"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "compute_type": { "type": "string", "minLength": 1 },
        "device_index": { "type": "integer", "minimum": 0 },
        "cpu_threads": { "type": "integer", "minimum": 0 }
      }
    },
    "TaskQueuedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "input_count", "effective_parameters"],
      "properties": {
        "position": { "type": "integer", "minimum": 0 },
        "input_count": { "type": "integer", "minimum": 1 },
        "model_id": { "enum": ["tiny", "base", "small", "medium", "large-v3", "large-v3-turbo"] },
        "recognition_strategy": {
          "enum": ["stable_primary", "mixed_zh_en", "zh_detail_review"]
        },
        "hardware": { "$ref": "#/$defs/ResolvedHardware" },
        "media_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "media_durations_seconds": {
          "type": "array",
          "items": {
            "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          }
        },
        "skipped_media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_path", "paths"],
            "properties": {
              "input_path": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "effective_parameters": { "type": "object" }
      }
    },
    "TaskProgressData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "current", "total"],
      "properties": {
        "stage": { "$ref": "#/$defs/TaskStage" },
        "current": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "input_path": { "type": "string", "minLength": 1 },
        "media_index": { "type": "integer", "minimum": 1 },
        "media_progress_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "media_elapsed_seconds": { "type": "number", "minimum": 0 },
        "task_elapsed_seconds": { "type": "number", "minimum": 0 },
        "media_status": {
          "enum": ["pending", "running", "completed", "failed", "skipped"]
        },
        "output_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "quality_diagnostics": { "$ref": "#/$defs/RecognitionQualityDiagnostics" }
      }
    },
    "RecognitionQualityDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected_language",
        "language_probability",
        "segment_count",
        "fallback_segment_count",
        "max_temperature",
        "low_confidence_count",
        "segments"
      ],
      "properties": {
        "detected_language": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "language_probability": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "segment_count": { "type": "integer", "minimum": 0 },
        "fallback_segment_count": { "type": "integer", "minimum": 0 },
        "max_temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "low_confidence_count": { "type": "integer", "minimum": 0 },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/LowConfidenceSegment" }
        },
        "recognition_strategy": {
          "enum": ["stable_primary", "mixed_zh_en", "zh_detail_review"]
        },
        "language_regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/LanguageRegionDiagnostic" }
        },
        "detail_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/DetailCandidateDiagnostic" }
        },
        "secondary_pass_count": { "type": "integer", "minimum": 0 },
        "replaced_region_count": { "type": "integer", "minimum": 0 },
        "review_region_count": { "type": "integer", "minimum": 0 },
        "rejected_region_count": { "type": "integer", "minimum": 0 },
        "hotword_audit": { "$ref": "#/$defs/HotwordAudit" }
      }
    },
    "LanguageRegionDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "top_language",
        "top_probability",
        "english_probability",
        "chinese_probability",
        "primary_text",
        "candidate_text",
        "decision",
        "reason"
      ],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "top_language": { "type": "string", "minLength": 1 },
        "top_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "english_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "chinese_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "primary_text": { "type": "string", "maxLength": 160 },
        "candidate_text": { "type": "string", "maxLength": 160 },
        "decision": { "enum": ["primary", "replaced", "review", "rejected"] },
        "reason": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "DetailCandidateDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "chinese_probability",
        "primary_text",
        "candidate_text",
        "decision",
        "reason",
        "primary_word_probability",
        "candidate_word_probability",
        "primary_log_probability",
        "candidate_log_probability",
        "recovered_hotwords"
      ],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "chinese_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "primary_text": { "type": "string", "maxLength": 160 },
        "candidate_text": { "type": "string", "maxLength": 160 },
        "decision": { "enum": ["replaced", "review", "rejected"] },
        "reason": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "primary_word_probability": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "candidate_word_probability": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "primary_log_probability": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "candidate_log_probability": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "recovered_hotwords": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "HotwordAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_count",
        "matched_count",
        "missing_count",
        "matched_terms",
        "missing_terms",
        "omitted_term_count"
      ],
      "properties": {
        "term_count": { "type": "integer", "minimum": 0 },
        "matched_count": { "type": "integer", "minimum": 0 },
        "missing_count": { "type": "integer", "minimum": 0 },
        "matched_terms": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_terms": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 }
        },
        "omitted_term_count": { "type": "integer", "minimum": 0 }
      }
    },
    "LowConfidenceSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start",
        "end",
        "text",
        "temperature",
        "avg_logprob",
        "compression_ratio",
        "no_speech_prob",
        "reasons"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "start": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "end": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "text": { "type": "string", "maxLength": 160 },
        "temperature": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "avg_logprob": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "compression_ratio": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "no_speech_prob": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "fallback_temperature",
              "low_log_probability",
              "high_compression_ratio",
              "silence_conflict"
            ]
          }
        }
      }
    },
    "TaskCompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_count", "failure_count", "outputs"],
      "properties": {
        "success_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "outputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "TaskFailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "details"],
      "properties": {
        "error_code": { "$ref": "#/$defs/ErrorCode" },
        "details": { "type": "object" }
      }
    },
    "TaskCancelledData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "enum": ["user", "shutdown", "superseded"] }
      }
    },
    "EventMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "event", "data"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "type": { "const": "event" },
        "request_id": { "$ref": "#/$defs/Identifier" },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "event": { "$ref": "#/$defs/EventCode" },
        "data": { "type": "object" },
        "message": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "event": { "const": "worker.ready" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/WorkerReadyData" } } }
        },
        {
          "if": { "properties": { "event": { "const": "command.completed" } } },
          "then": {
            "required": ["request_id"],
            "properties": { "data": { "$ref": "#/$defs/CommandCompletedData" } }
          }
        },
        {
          "if": { "properties": { "event": { "const": "model.loading" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/ModelLoadingData" } } }
        },
        {
          "if": { "properties": { "event": { "const": "model.ready" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/ModelReadyData" } } }
        },
        {
          "if": { "properties": { "event": { "const": "task.queued" } } },
          "then": {
            "required": ["request_id", "task_id"],
            "properties": { "data": { "$ref": "#/$defs/TaskQueuedData" } }
          }
        },
        {
          "if": { "properties": { "event": { "const": "task.progress" } } },
          "then": {
            "required": ["task_id"],
            "properties": { "data": { "$ref": "#/$defs/TaskProgressData" } }
          }
        },
        {
          "if": { "properties": { "event": { "const": "task.completed" } } },
          "then": {
            "required": ["task_id"],
            "properties": { "data": { "$ref": "#/$defs/TaskCompletedData" } }
          }
        },
        {
          "if": { "properties": { "event": { "const": "task.failed" } } },
          "then": {
            "required": ["task_id"],
            "properties": { "data": { "$ref": "#/$defs/TaskFailedData" } }
          }
        },
        {
          "if": { "properties": { "event": { "const": "task.cancelled" } } },
          "then": {
            "required": ["task_id"],
            "properties": { "data": { "$ref": "#/$defs/TaskCancelledData" } }
          }
        }
      ]
    },
    "ErrorMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "code", "data"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "type": { "const": "error" },
        "request_id": { "$ref": "#/$defs/Identifier" },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "data": { "type": "object" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
