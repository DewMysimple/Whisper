{
  "name": "whisper-subtitle-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "corepack pnpm --filter @whisper-subtitle/web build",
    "check": "corepack pnpm check:repo && corepack pnpm check:memory && corepack pnpm check:model-catalog && corepack pnpm check:preset-catalog && corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test",
    "check:repo": "python tools/maintenance/check_repository_hygiene.py",
    "check:memory": "python wiki-memory/工具/memory_lint.py check",
    "generate:model-catalog": "python tools/codegen/generate_model_catalog.py",
    "generate:preset-catalog": "python tools/codegen/generate_preset_catalog.py",
    "check:model-catalog": "python tools/codegen/generate_model_catalog.py --check",
    "check:preset-catalog": "python tools/codegen/generate_preset_catalog.py --check",
    "desktop:build": "corepack pnpm build && corepack pnpm --filter @whisper-subtitle/desktop tauri build --no-bundle",
    "desktop:dev": "corepack pnpm --filter @whisper-subtitle/desktop tauri dev",
    "dev": "corepack pnpm desktop:dev",
    "e2e": "corepack pnpm --filter @whisper-subtitle/web e2e",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/build.ps1",
    "release:build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/build.ps1 -IncludeInstaller",
    "format": "prettier --write package.json pnpm-workspace.yaml .prettierrc.json apps",
    "format:check": "prettier --check package.json pnpm-workspace.yaml .prettierrc.json apps",
    "lint": "corepack pnpm --filter @whisper-subtitle/web lint",
    "test": "corepack pnpm --filter @whisper-subtitle/web test",
    "typecheck": "corepack pnpm --filter @whisper-subtitle/web typecheck",
    "web:dev": "corepack pnpm --filter @whisper-subtitle/web dev",
    "workspace:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/maintenance/clean_workspace.ps1",
    "workspace:clean:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/maintenance/clean_workspace.ps1 -Apply"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  }
}
